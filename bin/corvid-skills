#!/usr/bin/env bash
set -euo pipefail

root_dir="${FLEDGE_PLUGIN_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
skills_dir="$root_dir/skills"
manifest_name=".corvid-skills.json"

usage() {
    cat <<'EOF'
Manage shared CorvidLabs agent skills in one repository.

Usage:
  fledge skills list
  fledge skills install <skill> [--repo <path>] [--host <auto|codex|claude|cursor|gemini>] [--link] [--dry-run]
  fledge skills status [--repo <path>]

Install copies a selected skill into a repository-local agent directory and
records the exact source revision and content digest in .corvid-skills.json.
It never overwrites an existing directory.
EOF
}

fail() {
    echo "corvid-skills: $*" >&2
    exit 2
}

require_python() {
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to maintain $manifest_name safely"
}

host_directory() {
    case "$1" in
        codex) printf '.codex/skills' ;;
        claude) printf '.claude/skills' ;;
        cursor) printf '.cursor/skills' ;;
        gemini) printf '.gemini/skills' ;;
        *) fail "unsupported host: $1" ;;
    esac
}

repository_root() {
    local requested="${1:-.}"
    [[ -d "$requested" ]] || fail "not a directory: $requested"
    git -C "$requested" rev-parse --show-toplevel 2>/dev/null || fail "not a Git repository: $requested"
}

ensure_safe_install_paths() {
    local repo="$1"
    local destination_rel="$2"
    local current="$repo"
    local component
    local components=()

    IFS='/' read -r -a components <<< "$destination_rel"
    for component in "${components[@]}"; do
        current="$current/$component"
        [[ ! -L "$current" ]] || fail "refusing symlinked install path: $current"
    done
    [[ ! -L "$repo/$manifest_name" ]] || fail "refusing symlinked manifest: $repo/$manifest_name"
}

validate_skill_source() {
    local skill="$1"
    [[ "$skill" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid skill name: $skill"
    [[ -d "$skills_dir/$skill" && ! -L "$skills_dir/$skill" && -f "$skills_dir/$skill/SKILL.md" ]] ||
        fail "unknown skill: $skill"
    [[ -z "$(find "$skills_dir/$skill" -type l -print -quit)" ]] ||
        fail "skill contains a symlink: $skill"
}

resolve_host() {
    local repo="$1"
    local requested="$2"
    if [[ "$requested" != "auto" ]]; then
        host_directory "$requested" >/dev/null
        printf '%s' "$requested"
        return
    fi

    local candidates=()
    local host
    for host in codex claude cursor gemini; do
        [[ -d "$repo/$(host_directory "$host")" ]] && candidates+=("$host")
    done
    if [[ ${#candidates[@]} -eq 1 ]]; then
        printf '%s' "${candidates[0]}"
        return
    fi
    if [[ ${#candidates[@]} -eq 0 ]]; then
        fail "cannot infer an agent host; pass --host codex, --host claude, --host cursor, or --host gemini"
    fi
    fail "multiple agent hosts are present (${candidates[*]}); pass --host explicitly"
}

directory_digest() {
    local directory="$1"
    (
        cd "$directory"
        find . -type f -print0 | LC_ALL=C sort -z | while IFS= read -r -d '' file; do
            if command -v shasum >/dev/null 2>&1; then
                shasum -a 256 "$file"
            else
                sha256sum "$file"
            fi
        done
    ) | if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    else
        sha256sum | awk '{print $1}'
    fi
}

list_skills() {
    find "$skills_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort
}

write_manifest_entry() {
    local manifest="$1"
    local skill="$2"
    local host="$3"
    local destination_rel="$4"
    local install_mode="$5"
    local revision="$6"
    local digest="$7"
    require_python
    python3 - "$manifest" "$skill" "$host" "$destination_rel" "$install_mode" "$revision" "$digest" <<'PY'
import datetime
import json
import os
import sys
import tempfile

manifest, skill, host, destination, mode, revision, digest = sys.argv[1:]
data = {"schema_version": 1, "source": "CorvidLabs/skills", "installs": []}
if os.path.exists(manifest):
    with open(manifest, encoding="utf-8") as source:
        data = json.load(source)
    if data.get("schema_version") != 1 or not isinstance(data.get("installs"), list):
        raise SystemExit(f"unsupported managed-skills manifest: {manifest}")
    if any(item.get("skill") == skill and item.get("host") == host for item in data["installs"]):
        raise SystemExit(f"managed install already recorded for {skill} on {host}")
data["source"] = "CorvidLabs/skills"
data["installs"].append({
    "skill": skill,
    "host": host,
    "destination": destination,
    "install_mode": mode,
    "source_revision": revision,
    "content_digest": digest,
    "installed_at": datetime.datetime.now(datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
})
directory = os.path.dirname(manifest) or "."
fd, temporary = tempfile.mkstemp(prefix=".corvid-skills.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        json.dump(data, output, indent=2, sort_keys=True)
        output.write("\n")
    os.replace(temporary, manifest)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

install_skill() {
    local skill="$1"
    shift
    local repo_arg="."
    local host_arg="auto"
    local link="false"
    local dry_run="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo) [[ $# -ge 2 ]] || fail "--repo needs a path"; repo_arg="$2"; shift 2 ;;
            --host) [[ $# -ge 2 ]] || fail "--host needs a value"; host_arg="$2"; shift 2 ;;
            --link) link="true"; shift ;;
            --dry-run) dry_run="true"; shift ;;
            *) fail "unknown option: $1" ;;
        esac
    done

    validate_skill_source "$skill"
    local repo host destination destination_rel revision digest manifest
    repo="$(repository_root "$repo_arg")"
    host="$(resolve_host "$repo" "$host_arg")"
    destination_rel="$(host_directory "$host")/$skill"
    destination="$repo/$destination_rel"
    manifest="$repo/$manifest_name"
    ensure_safe_install_paths "$repo" "$destination_rel"
    [[ ! -e "$destination" && ! -L "$destination" ]] || fail "destination already exists: $destination"

    revision="$(git -C "$root_dir" rev-parse HEAD 2>/dev/null || printf 'working-tree')"
    digest="$(directory_digest "$skills_dir/$skill")"
    if [[ "$dry_run" == "true" ]]; then
        local requested_mode="copy"
        [[ "$link" == "true" ]] && requested_mode="link"
        printf 'Would install %s for %s at %s (%s, revision %s)\n' \
            "$skill" "$host" "$destination" "$requested_mode" "$revision"
        return
    fi

    mkdir -p "$(dirname "$destination")"
    if [[ "$link" == "true" ]]; then
        ln -s "$skills_dir/$skill" "$destination"
        write_manifest_entry "$manifest" "$skill" "$host" "$destination_rel" "link" "$revision" "$digest"
    else
        local temporary="${destination}.tmp.$$"
        cp -R "$skills_dir/$skill" "$temporary"
        if ! write_manifest_entry "$manifest" "$skill" "$host" "$destination_rel" "copy" "$revision" "$digest"; then
            rm -rf "$temporary"
            exit 1
        fi
        mv "$temporary" "$destination"
    fi
    printf 'Installed %s for %s at %s (revision %s)\n' "$skill" "$host" "$destination" "$revision"
}

status_skills() {
    local repo_arg="."
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo) [[ $# -ge 2 ]] || fail "--repo needs a path"; repo_arg="$2"; shift 2 ;;
            *) fail "unknown option: $1" ;;
        esac
    done
    local repo manifest
    repo="$(repository_root "$repo_arg")"
    manifest="$repo/$manifest_name"
    if [[ ! -f "$manifest" ]]; then
        echo "No managed CorvidLabs skills are installed in $repo"
        return
    fi
    require_python
    local status_output=""
    while IFS=$'\t' read -r skill host destination_rel revision install_mode expected_digest; do
        local destination="$repo/$destination_rel"
        local state="missing"
        local safe_manifest="true"
        local expected_destination_rel=""
        local unsafe_parent="false"
        local current="$repo"
        local components=()
        local index
        case "$host" in
            codex) expected_destination_rel=".codex/skills/$skill" ;;
            claude) expected_destination_rel=".claude/skills/$skill" ;;
            cursor) expected_destination_rel=".cursor/skills/$skill" ;;
            gemini) expected_destination_rel=".gemini/skills/$skill" ;;
            *) safe_manifest="false" ;;
        esac
        [[ "$skill" =~ ^[a-z0-9][a-z0-9-]*$ ]] || safe_manifest="false"
        [[ "$destination_rel" == "$expected_destination_rel" ]] || safe_manifest="false"
        if [[ "$safe_manifest" == "true" ]]; then
            IFS='/' read -r -a components <<< "$destination_rel"
            for ((index = 0; index < ${#components[@]} - 1; index++)); do
                current="$current/${components[$index]}"
                if [[ -L "$current" ]]; then
                    unsafe_parent="true"
                    break
                fi
            done
        fi

        if [[ "$safe_manifest" != "true" || "$unsafe_parent" == "true" ]]; then
            state="modified"
        elif [[ "$install_mode" == "link" && -L "$destination" ]]; then
            if [[ "$(readlink "$destination")" == "$skills_dir/$skill" ]]; then
                local actual_digest
                actual_digest="$(directory_digest "$skills_dir/$skill")"
                [[ "$actual_digest" == "$expected_digest" ]] && state="current" || state="modified"
            else
                state="modified"
            fi
        elif [[ -d "$destination" && ! -L "$destination" ]]; then
            local actual_digest
            actual_digest="$(directory_digest "$destination")"
            [[ "$actual_digest" == "$expected_digest" ]] && state="current" || state="modified"
        elif [[ -e "$destination" || -L "$destination" ]]; then
            state="modified"
        fi
        local status_line
        printf -v status_line '%s\t%s\t%s\t%s\t%s\t%s' \
            "$skill" "$host" "$destination_rel" "$revision" "$install_mode" "$state"
        if [[ -n "$status_output" ]]; then
            status_output+=$'\n'
        fi
        status_output+="$status_line"
    done < <(python3 - "$manifest" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    data = json.load(source)
for item in data.get("installs", []):
    fields = (
        item["skill"],
        item["host"],
        item["destination"],
        item["source_revision"],
        item["install_mode"],
        item.get("content_digest", ""),
    )
    if any("\t" in str(field) or "\n" in str(field) for field in fields):
        raise SystemExit("invalid control character in managed-skills manifest")
    print("\t".join(str(field) for field in fields))
PY
    )
    [[ -z "$status_output" ]] || printf '%s\n' "$status_output"
}

case "${1:-}" in
    list) [[ $# -eq 1 ]] || fail "list accepts no options"; list_skills ;;
    install) [[ $# -ge 2 ]] || { usage; exit 2; }; install_skill "$2" "${@:3}" ;;
    status) status_skills "${@:2}" ;;
    -h|--help|help|'') usage ;;
    *) fail "unknown command: $1" ;;
esac
