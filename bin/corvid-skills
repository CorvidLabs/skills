#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
skills_dir="$root_dir/skills"

usage() {
    cat <<'EOF'
Usage:
  corvid-skills list
  corvid-skills install <skill> --repo <path> --host <codex|claude|cursor> [--link]
EOF
}

host_directory() {
    case "$1" in
        codex) printf '.codex/skills' ;;
        claude) printf '.claude/skills' ;;
        cursor) printf '.cursor/skills' ;;
        *)
            echo "Unsupported host: $1" >&2
            exit 2
            ;;
    esac
}

list_skills() {
    find "$skills_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

install_skill() {
    local skill="$1"
    shift
    local repo=""
    local host=""
    local link="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo) repo="$2"; shift 2 ;;
            --host) host="$2"; shift 2 ;;
            --link) link="true"; shift ;;
            *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
        esac
    done

    [[ -n "$repo" && -n "$host" ]] || { usage; exit 2; }
    [[ -d "$repo/.git" || -f "$repo/.git" ]] || { echo "Not a Git repository: $repo" >&2; exit 2; }
    [[ -f "$skills_dir/$skill/SKILL.md" ]] || { echo "Unknown skill: $skill" >&2; exit 2; }

    local destination="$repo/$(host_directory "$host")/$skill"
    mkdir -p "$(dirname "$destination")"
    if [[ -e "$destination" || -L "$destination" ]]; then
        echo "Destination already exists: $destination" >&2
        echo "Remove or rename it after reviewing its contents, then rerun install." >&2
        exit 2
    fi
    if [[ "$link" == "true" ]]; then
        ln -s "$skills_dir/$skill" "$destination"
    else
        cp -R "$skills_dir/$skill" "$destination"
    fi

    local revision
    revision="$(git -C "$root_dir" rev-parse HEAD 2>/dev/null || printf 'working-tree')"
    local manifest="$repo/.corvid-skills.json"
    if [[ -e "$manifest" ]]; then
        echo "Installed $skill for $host at $destination" >&2
        echo "Existing manifest retained: $manifest" >&2
    else
        printf '{\n  "source": "CorvidLabs/skills",\n  "revision": "%s",\n  "host": "%s",\n  "skills": ["%s"]\n}\n' \
            "$revision" "$host" "$skill" > "$manifest"
    fi
    echo "Installed $skill for $host at $destination"
}

case "${1:-}" in
    list) list_skills ;;
    install)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        install_skill "$2" "${@:3}"
        ;;
    *) usage; exit 2 ;;
esac
